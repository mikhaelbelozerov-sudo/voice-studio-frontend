VITE_API_BASE_URL=https://your-backend-host/api
VITE_SUPPORT_TELEGRAM_LINK=https://t.me/your_support_account
# Совпадайте с PRO_CREATOR_STARS_PRICE на backend (Render)
VITE_PRO_CREATOR_STARS=650
# Имя бота без @ — для ссылок «пригласить друга» (Mini App startapp)
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
# Короткое имя Mini App из BotFather (сегмент после имени бота: t.me/bot/<это>).
# НЕ указывайте URL фронтенда (Vercel) — иначе ссылка-приглашение сломается.
VITE_TELEGRAM_MINI_APP_SLUG=app
# Как собирать ссылку «пригласить друга»:
# - named — https://t.me/BOT/app?startapp=ref_… (по умолчанию, Direct link из BotFather)
# - main   — https://t.me/BOT?startapp=ref_… (главный Mini App, без /app в пути — попробуйте при глюках iOS)
# - https  — https://ВАШ_VERCEL/?tgWebAppStartParam=ref_… (прямой URL сайта; нужен VITE_PUBLIC_MINI_APP_ORIGIN)
# VITE_REFERRAL_LINK_MODE=named
# Ровно тот же HTTPS, что указан как URL Mini App в BotFather (без слэша в конце):
# VITE_PUBLIC_MINI_APP_ORIGIN=https://voice-studio-frontend.vercel.app
# Опционально: те же premium voice_id, что и ELEVENLABS_PREMIUM_VOICE_IDS на backend
# VITE_PREMIUM_VOICE_IDS=
